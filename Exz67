-- ขยายเต็มจอ (+)
local isMaximized = false
local normalSize = UDim2.new(0, 420, 0, 320)
local normalPos = UDim2.new(0.5, -210, 0.5, -160)

MaxBtn.MouseButton1Click:Connect(function()
    isMaximized = not isMaximized
    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if isMaximized then
        normalSize = MainFrame.Size
        normalPos = MainFrame.Position
        TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0.9, 0, 0.9, 0), Position = UDim2.new(0.05, 0, 0.05, 0)}):Play()
    else
        TweenService:Create(MainFrame, tweenInfo, {Size = normalSize, Position = normalPos}):Play()
    end
end)

