local function createFeatureToggle(name, callback)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(1, -10, 0, 45)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
    toggleBtn.Text = "  " .. name .. " [ OFF ]"
    toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    toggleBtn.TextSize = 14
    toggleBtn.Font = Enum.Font.GothamSemibold
    toggleBtn.TextXAlignment = Enum.TextXAlignment.Left
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = toggleBtn
    
    local active = false
    toggleBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
            toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            toggleBtn.Text = "  " .. name .. " [ ON ]"
        else
            toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
            toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            toggleBtn.Text = "  " .. name .. " [ OFF ]"
        end
        callback(active)
    end)
    
    toggleBtn.Parent = ContentScroll
end

